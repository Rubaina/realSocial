# Who runs this service (a person or organisation). Shown to people in the first message. Required for WhatsApp.
OPERATOR_NAME=realSocial

# Password for the review page at /admin. Sign in with your name and this password.
# Without it the review page is off and no program can be approved.
ADMIN_TOKEN=

# WhatsApp Cloud API (Meta). Leave empty to run only the review page, or use the terminal simulator.
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v21.0

# Claude API key. Needed for the review page's "Read page and draft" button. It also lets the bot understand
# free text and voice transcripts; without it, a keyword matcher is used for those.
ANTHROPIC_API_KEY=
INTENT_MODEL=claude-haiku-5-5
EXTRACT_MODEL=claude-opus-5-5

PORT=3000
DB_PATH=data/app.db
DEFAULT_COUNTRY=id
